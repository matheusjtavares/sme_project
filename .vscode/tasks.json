{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: react",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://127.0.0.1:5173"
        }
      },
      "presentation": {
        "group": "frontend",
        "panel": "dedicated",
        "reveal": "never"
      }
    }
  ]
}